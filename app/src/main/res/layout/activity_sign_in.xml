<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/optionsMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SDK Options"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/popupModeOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Popup Mode" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/darkModeOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dark Mode" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/shapeOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rectangular Button Shape" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sdkOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Verify all users" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/enhancedBtmSheetEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enhanced Bottom Sheet" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/neverCallEnhancedBtmSheetEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Never call Enhanced Bottom Sheet" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Heading Options" />

            <Spinner
                android:id="@+id/heading_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="CTA Options" />

            <Spinner
                android:id="@+id/cta_prefix_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Button Color" />

            <Spinner
                android:id="@+id/color_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Button Text Color" />

            <Spinner
                android:id="@+id/color_text_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Dismiss Options" />

            <Spinner
                android:id="@+id/dismiss_options_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <RadioGroup
                android:id="@+id/additionalFooters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/uan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Use Another Number (UAN)" />

                <RadioButton
                    android:id="@+id/uam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Use Another Method" />

                <RadioButton
                    android:id="@+id/edm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter Details Manually" />

                <RadioButton
                    android:id="@+id/idl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="I'll do later" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/scopes_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/phone_scope"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:tag="phone"
                    android:text="Phone Number" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/profile_scope"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:tag="profile"
                    android:text="Profile" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/openId_scope"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="openid"
                    android:text="OpenId" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/offline_access_scope"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="offline_access"
                    android:text="Offline Access" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/email_access_scope"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="email"
                    android:text="Email Address" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/address_access_scope"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="address"
                    android:text="Address" />
            </LinearLayout>

            <EditText
                android:id="@+id/localeEt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Locale (e.g. en, hi)" />

            <Button
                android:id="@+id/buttonGo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Go to Login" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/landingLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <RelativeLayout
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/loaderLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txtLoader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..." />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/formLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/edtPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Phone Number"
                android:inputType="phone" />

            <Button
                android:id="@+id/btnProceed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Proceed" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profileLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/edtFirstName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="First Name" />

            <EditText
                android:id="@+id/edtLastName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Last Name" />

            <TextView
                android:id="@+id/tvOtp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter OTP" />

            <EditText
                android:id="@+id/edtOtpCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="OTP" />

            <Button
                android:id="@+id/btnVerify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Verify" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/timerTextProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

    </RelativeLayout>
</ScrollView>
